    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^1.6.0"
  }
