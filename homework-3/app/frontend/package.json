{
  "name": "horizon-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.16"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_USE_MOCKS=true vite",
